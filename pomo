parse_task_arg() {
    # Parsing opsional -t <task> / --task <task> / --task=<task>
    while (( $# > 0 )); do
        case $1 in
            -t|--task)
                [[ -n ${2:-} ]] || die "option '$1' requires a task description"
                SESSION_TASK=$2
                shift 2
                ;;
            --task=*)
                SESSION_TASK=${1#--task=}
                [[ -n $SESSION_TASK ]] || die "option '--task=' requires a task description"
                shift
                ;;
            *)
                die "unknown option: '$1'" "Try 'pomo --help' for usage information."
                ;;
        esac
    done
}

main() {
    local cmd=${1:-}
    case $cmd in
        '')
            load_theme
            load_config
            start_session focus confirm
            ;;
        -t|--task|--task=*)
            parse_task_arg "$@"
            load_theme
            load_config
            start_session focus confirm
            ;;
        start)
            shift
            parse_task_arg "$@"
            load_theme
            load_config
            start_session focus
            ;;
        -w|--short)
            load_theme
            load_config
            start_session short_break
            ;;
        -W|--long)
            load_theme
            load_config
            start_session long_break
            ;;
        resume)
            load_theme
            load_config
            resume_session
            ;;
        stats)
            load_theme
            show_stats
            ;;
        recap)
            load_theme
            show_recap "${2:-today}"
            ;;
        status)
            show_status "${2:-}"
            ;;
        config)
            load_config
            show_config
            ;;
        update)
            self_update "$(resolve_self)"
            ;;
        theme|themes)
            if [[ -n ${2:-} ]]; then
                if ! theme_valid "$2"; then
                    die "unknown theme: '$2'" "Available themes: ${THEME_NAMES[*]}"
                fi
                THEME_NAME=$2
                save_theme
                printf 'Theme set to %s (saved in %s).\n' "$THEME_NAME" "$THEME_FILE"
            else
                load_theme
                show_theme
            fi
            ;;
        -h|--help|help)
            show_help
            ;;
        -v|--version|version)
            show_version
            ;;
        *)
            die "unknown command or option: '$cmd'" "Try 'pomo --help' for usage information."
            ;;
    esac
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Bangun tabel glyph font sekali di awal
font_init

# Jalankan main hanya jika dieksekusi langsung (bukan di-source untuk testing)
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
