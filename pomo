        "  Focus minutes  : $(( ${FOCUS_SECS[$today]:-0} / 60 ))"
        "  Breaks taken   : ${BREAK_COUNT[$today]:-0}"
    )
    if read_history; then
        for (( i = 6; i >= 0; i-- )); do
            day=$(date -d "-$i day" +%F)
            mins=$(( ${FOCUS_SECS[$day]:-0} / 60 ))
            (( mins > max_minutes )) && max_minutes=$mins
        done
        OVERLAY_LINES+=('' 'Last 7 days:')
        for (( i = 6; i >= 0; i-- )); do
            day=$(date -d "-$i day" +%F)
            ts=$(( ts + ${FOCUS_COUNT[$day]:-0} ))
            tm=$(( tm + ${FOCUS_SECS[$day]:-0} / 60 ))
            mins=$(( ${FOCUS_SECS[$day]:-0} / 60 ))
            bar=''
            if (( max_minutes > 0 )); then
                filled=$(( mins * 20 / max_minutes ))
                for (( j = 0; j < filled; j++ )); do bar+='▓'; done
            fi
            OVERLAY_LINES+=("  $day  ${FOCUS_COUNT[$day]:-0} sess  ${mins} min  $bar")
        done
        OVERLAY_LINES+=('' "7-day total: $ts sessions · $tm minutes")
    else
        OVERLAY_LINES+=('' 'No sessions recorded yet.')
    fi
    draw_overlay 'STATS' 'Press any key to go back'
    local k=''
    read_key k || true
}

show_duration_config_overlay() {
    # Overlay untuk mengustom durasi sesi
    while :; do
        local fm=$(( FOCUS_SECONDS / 60 ))
        local sm=$(( SHORT_BREAK_SECONDS / 60 ))
        local lm=$(( LONG_BREAK_SECONDS / 60 ))
        
        OVERLAY_LINES=(
            "Current durations:"
            "  Focus session      : $fm min"
            "  Short break        : $sm min"
            "  Long break         : $lm min"
            ''
            'Edit durations:'
            '[f] Change focus duration'
            '[s] Change short break duration'
            '[l] Change long break duration'
            '[r] Reset to defaults (25/5/15 min)'
            '[a] Save to config file'
        )
        draw_overlay 'CUSTOMIZE DURATIONS' 'Press [b] to go back'
        
        local key=''
        if ! IFS= read -r -s -n 1 key; then
            return
        fi
        
        case $key in
            f|F)
                prompt_for_duration "Focus session" "$fm"
                fm=$DURATION_RESULT
                FOCUS_SECONDS=$(( fm * 60 ))
                ;;
            s|S)
                prompt_for_duration "Short break" "$sm"
                sm=$DURATION_RESULT
                SHORT_BREAK_SECONDS=$(( sm * 60 ))
                ;;
            l|L)
                prompt_for_duration "Long break" "$lm"
                lm=$DURATION_RESULT
                LONG_BREAK_SECONDS=$(( lm * 60 ))
                ;;
            r|R)
                FOCUS_SECONDS=1500
                SHORT_BREAK_SECONDS=300
                LONG_BREAK_SECONDS=900
                ;;
            a|A)
                save_duration_config
                ;;
            b|B)
                return
                ;;
        esac
    done
}

prompt_for_duration() {
    # $1 = label, $2 = current value in minutes.
    # Result is returned in the global DURATION_RESULT; do not use command
    # substitution here because draw_overlay writes to the terminal.
    local label=$1 current=$2 input='' ch rc k redraw=1
    DURATION_RESULT=$current

    while :; do
        if (( redraw )); then
            OVERLAY_LINES=(
                "Set $label duration (minutes):"
                "Current: $current min"
                ''
                "Enter new duration (1-120): $input"
                ''
                '[Enter to accept, Esc to cancel]'
            )
            draw_overlay "$label" ''
            redraw=0
        fi

        ch=''
        if IFS= read -r -s -n 1 -t 0.1 ch; then
            if [[ -z $ch ]]; then
                # Enter: accept the value, or keep the current value if empty.
                if [[ -z $input ]]; then
                    DURATION_RESULT=$current
                    return 0
                elif [[ $input =~ ^[0-9]+$ ]] && (( 10#$input >= 1 && 10#$input <= 120 )); then
                    DURATION_RESULT=$((10#$input))
                    return 0
                else
                    OVERLAY_LINES=(
                        'Invalid input!'
                        'Enter a whole number between 1 and 120.'
                        ''
                        "Your input: $input"
                    )
                    draw_overlay 'ERROR' 'Press any key to continue'
                    while :; do
                        k=''
                        if IFS= read -r -s -n 1 -t 0.1 k; then
                            break
                        else
                            rc=$?
                            (( rc > 128 )) && continue
                            break
                        fi
                    done
                    input=''
                    redraw=1
                fi
            else
                case $ch in
                    $'\x1b')
                        DURATION_RESULT=$current
                        return 0
                        ;;
                    $'\x7f'|$'\b')
                        input=${input%?}
                        redraw=1
                        ;;
                    [0-9])
                        if (( ${#input} < 3 )); then
                            input+=$ch
                            redraw=1
                        fi
                        ;;
                esac
            fi
        else
            rc=$?
            if (( rc > 128 )); then
                continue
            fi
            # EOF or terminal input error: safely retain the current duration.
            DURATION_RESULT=$current
            return 0
        fi
    done
}
