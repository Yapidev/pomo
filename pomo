            esac
            ;;
        matrix)
            if (( TRUECOLOR )); then set_grad_rgb '180;255;180' '80;255;80' '0;235;0' '0;185;0' '0;130;0'
            else set_grad_256 120 82 46 40 28; fi
            ;;
        mono)
            C_DIGIT_GRAD=("$C_BOLD" "$C_BOLD" '' '' "$C_DIM")
            ;;
        *)
            C_DIGIT_GRAD=("$C_DIGITS" "$C_DIGITS" "$C_DIGITS" "$C_DIGITS" "$C_DIGITS")
            ;;
    esac
}

set_mode_colors() {
    # Warna per mode: fokus hijau/cyan, break pendek kuning, break panjang biru/magenta
    case $1 in
        focus)
            C_TITLE=$C_CYAN; C_DIGITS=$C_GREEN; C_BORDER=$C_CYAN; C_BAR=$C_GREEN
            C_COLON=$C_CYAN; C_KEY=$C_CYAN ;;
        short_break)
            C_TITLE=$C_YELLOW; C_DIGITS=$C_YELLOW; C_BORDER=$C_YELLOW; C_BAR=$C_YELLOW
            C_COLON=$C_WHITE; C_KEY=$C_YELLOW ;;
        long_break)
            C_TITLE=$C_MAGENTA; C_DIGITS=$C_MAGENTA; C_BORDER=$C_BLUE; C_BAR=$C_BLUE
            C_COLON=$C_MAGENTA; C_KEY=$C_MAGENTA ;;
    esac
    if [[ $THEME_NAME == mono ]] && (( COLOR_ENABLED )); then
        C_TITLE=$C_BOLD; C_BORDER=$C_DIM; C_BAR=$C_BOLD; C_COLON=$C_BOLD; C_KEY=$C_BOLD
    fi
    set_digit_gradient "$1"
}

draw_ui() {
    # $1 sisa detik, $2 total detik, $3 judul mode, $4 status pause (0/1),
    # $5 reveal 0-100 (opsional; untuk animasi intro digit)
    local remaining=$1 total=$2 label=$3 paused=$4 reveal=${5:-100}
    local cols=$TERM_COLS rows=$TERM_LINES
    local frame='' pad pad_s line n i r c seg
    local mm ss t elapsed pct bar_w bar

    # Terminal terlalu kecil: timer tetap jalan, tampilkan pesan singkat.
    # Redraw memakai cursor-home seperti layar utama (tanpa clear penuh,
    # agar tidak flicker setiap detik).
    if (( cols < MIN_COLS || rows < MIN_ROWS )); then
        local msg='Terminal too small (need 45x17) — the timer keeps running.'
        pad=$(( (cols - ${#msg}) / 2 )); pad=$(( pad < 0 ? 0 : pad ))
        printf -v line '%*s%s%s%s' "$pad" '' "$C_YELLOW" "$msg" "$C_RESET"
        printf '%s%s%s%s' "${E}[H" "$line" "${E}[K" "${E}[0J"
        return 0
    fi

    mm=$(( remaining / 60 ))
    ss=$(( remaining % 60 ))
    printf -v t '%02d:%02d' "$mm" "$ss"

    elapsed=$(( total - remaining ))
    (( elapsed < 0 )) && elapsed=0
    pct=$(( elapsed * 100 / total ))
    (( pct < 0 )) && pct=0
    (( pct > 100 )) && pct=100

    # Warna aktif card: saat pause, border/badge/bar beralih kuning dan digit meredup
    local c_card_border=$C_BORDER c_hdr=$C_TITLE c_bar_active=$C_BAR c_colon_active=$C_COLON
    if (( paused )); then
        c_card_border=$C_YELLOW
        c_hdr=$C_YELLOW
        c_bar_active=$C_YELLOW
        c_colon_active=$C_DIM
    fi

    # ---- lebar digit & unified rounded card ----
    local time_w=0
    for (( i = 0; i < ${#t}; i++ )); do
        c=${t:i:1}
        (( i > 0 )) && time_w=$(( time_w + 2 ))
        if [[ $c == ':' ]]; then
            time_w=$(( time_w + 2 ))
        else
            time_w=$(( time_w + 6 ))
        fi
    done

    local card_inner=$(( time_w + 10 ))
    (( card_inner < 46 )) && card_inner=46
    if (( card_inner + 2 > cols )); then
        card_inner=$(( cols - 2 ))
    fi
    local card_w=$(( card_inner + 2 ))

    # ---- baris-baris digit besar rounded half-block dengan gradient vertikal ----
    local timer_rows=() rowstr row_color colon_color
    if (( paused )); then
        colon_color=$C_DIM
    elif (( ANIM_ENABLED && remaining % 2 )); then
        colon_color="${C_DIM}${c_colon_active}"
    else
        colon_color=$c_colon_active
    fi
    for (( r = 0; r < 5; r++ )); do
        row_color=${C_DIGIT_GRAD[r]:-$C_DIGITS}
        if (( paused )); then
            row_color="${C_DIM}${row_color}"
        fi
        seg=''
        for (( i = 0; i < ${#t}; i++ )); do
            c=${t:i:1}
            if (( i > 0 )); then seg+='  '; fi
            rowstr=${FONTROWS[${c}_${r}]}
            if [[ $c == ':' ]]; then
                seg+="${colon_color}${rowstr}${C_RESET}"
            else
                if (( ANIM_ENABLED && reveal < 100 )); then
                    rowstr=$(pixel_anim "$rowstr" "$i" "$r" "$reveal")
                fi
                seg+="${row_color}${rowstr}${C_RESET}"
            fi
        done
        timer_rows[r]=$seg
    done

    # ---- smooth sleek progress bar (presisi setengah sel: ━ / ╸ / ─) ----
    bar_w=$(( card_inner - 12 ))
    (( bar_w > BAR_WIDTH )) && bar_w=$BAR_WIDTH
    (( bar_w < 8 )) && bar_w=8
    local steps=$(( pct * bar_w * 2 / 100 ))
    local full=$(( steps / 2 ))
    local half=$(( steps % 2 ))
    local rest=$(( bar_w - full - half ))
    (( rest < 0 )) && rest=0
    local bar_fill='' bar_rest=''
    for (( i = 0; i < full; i++ )); do bar_fill+='━'; done
    (( half )) && bar_fill+='╸'
    for (( i = 0; i < rest; i++ )); do bar_rest+='─'; done
    local pct_str
    printf -v pct_str '%3d%%' "$pct"
    bar="${c_bar_active}${bar_fill}${C_RESET}${C_DIM}${bar_rest}${C_RESET}  ${c_hdr}${C_BOLD}${pct_str}${C_RESET}"
    local bar_plain_w=$(( bar_w + 6 ))

    # ---- susun frame (13 baris: card 11 baris + jarak 1 + keyhints 1) ----
    local top_pad=$(( (rows - 13) / 2 ))
    top_pad=$(( top_pad < 0 ? 0 : top_pad ))
    for (( n = 0; n < top_pad; n++ )); do frame+="${E}[K"$'\n'; done

    pad=$(( (cols - card_w) / 2 )); pad=$(( pad < 0 ? 0 : pad ))
    printf -v pad_s '%*s' "$pad" ''

    local blank_inner hbar
    printf -v blank_inner '%*s' "$card_inner" ''
    hbar=${blank_inner// /─}

    # Border atas card dengan badge mode/pause + indikator siklus
    local hdr_left hdr_right hdr_left_s hdr_right_s dots_colored='' dch
    if (( paused )); then
        hdr_left='❚❚ PAUSED'
        hdr_left_s="${C_YELLOW}${C_BOLD}❚❚ PAUSED${C_RESET}"
    else
        hdr_left="● $label"
        hdr_left_s="${c_hdr}${C_BOLD}● ${label}${C_RESET}"
    fi
    for (( i = 0; i < ${#CYCLE_DOTS}; i++ )); do
        dch=${CYCLE_DOTS:i:1}
        if [[ $dch == '●' ]]; then
            dots_colored+="${c_hdr}●${C_RESET}"
        else
            dots_colored+="${C_DIM}○${C_RESET}"
        fi
    done
    hdr_right="Cycle: $CYCLE_DOTS"
    hdr_right_s="${C_DIM}Cycle: ${C_RESET}${dots_colored}"

    local mid_dashes=$(( card_inner - ${#hdr_left} - ${#hdr_right} - 6 ))
    (( mid_dashes < 1 )) && mid_dashes=1
    local mid_bar
    printf -v mid_bar '%*s' "$mid_dashes" ''
    mid_bar=${mid_bar// /─}

    printf -v line '%s%s╭─ %s%s %s%s %s%s ─╮%s' \
        "$pad_s" "$c_card_border" "$hdr_left_s" "$c_card_border" \
        "$mid_bar" "$C_RESET" "$hdr_right_s" "$c_card_border" "$C_RESET"
    frame+="$line${E}[K"$'\n'

    # Baris kosong atas di dalam card
    printf -v line '%s%s│%s%s%s│%s' "$pad_s" "$c_card_border" "$C_RESET" "$blank_inner" "$c_card_border" "$C_RESET"
    frame+="$line${E}[K"$'\n'

    # 5 baris digit besar rata tengah di dalam card
    local lp rp lp_s rp_s
    lp=$(( (card_inner - time_w) / 2 )); (( lp < 0 )) && lp=0
    rp=$(( card_inner - time_w - lp )); (( rp < 0 )) && rp=0
    printf -v lp_s '%*s' "$lp" ''
    printf -v rp_s '%*s' "$rp" ''
    for (( r = 0; r < 5; r++ )); do
        printf -v line '%s%s│%s%s%s%s%s│%s' \
            "$pad_s" "$c_card_border" "$C_RESET" "$lp_s" "${timer_rows[r]}" "$rp_s" "$c_card_border" "$C_RESET"
        frame+="$line${E}[K"$'\n'
    done

    # Baris kosong pemisah antara digit & progress bar
    printf -v line '%s%s│%s%s%s│%s' "$pad_s" "$c_card_border" "$C_RESET" "$blank_inner" "$c_card_border" "$C_RESET"
    frame+="$line${E}[K"$'\n'

    # Progress bar di dalam card
    lp=$(( (card_inner - bar_plain_w) / 2 )); (( lp < 0 )) && lp=0
    rp=$(( card_inner - bar_plain_w - lp )); (( rp < 0 )) && rp=0
    printf -v lp_s '%*s' "$lp" ''
    printf -v rp_s '%*s' "$rp" ''
    printf -v line '%s%s│%s%s%s%s%s│%s' \
        "$pad_s" "$c_card_border" "$C_RESET" "$lp_s" "$bar" "$rp_s" "$c_card_border" "$C_RESET"
    frame+="$line${E}[K"$'\n'

    # Baris info elapsed (plus indikator tracking bila aktif pada sesi fokus)
    local info
    printf -v info 'Elapsed %02d:%02d of %02d:%02d' \
        $(( elapsed / 60 )) $(( elapsed % 60 )) $(( total / 60 )) $(( total % 60 ))
    if [[ $CURRENT_MODE == focus && $TRACKER_BACKEND != none && $TRACKER_BACKEND != off ]]; then
        info+='  ·  tracking'
    fi
    lp=$(( (card_inner - ${#info}) / 2 )); (( lp < 0 )) && lp=0
    rp=$(( card_inner - ${#info} - lp )); (( rp < 0 )) && rp=0
    printf -v lp_s '%*s' "$lp" ''
    printf -v rp_s '%*s' "$rp" ''
    printf -v line '%s%s│%s%s%s%s%s%s%s│%s' \
        "$pad_s" "$c_card_border" "$C_RESET" "$lp_s" "$C_DIM" "$info" "$C_RESET" "$rp_s" "$c_card_border" "$C_RESET"
    frame+="$line${E}[K"$'\n'

    # Border bawah card
    printf -v line '%s%s╰%s╯%s' "$pad_s" "$c_card_border" "$hbar" "$C_RESET"
    frame+="$line${E}[K"$'\n'
    frame+="${E}[K"$'\n'

    # Footer keyhints bersih dengan keycap beraksen
    local status plain
    if (( paused )); then
        plain='p resume  ·  s skip  ·  m menu  ·  q quit'
        status="${C_YELLOW}${C_BOLD}p${C_RESET} ${C_WHITE}resume${C_RESET}${C_DIM}  ·  ${C_RESET}${C_KEY}${C_BOLD}s${C_RESET} ${C_DIM}skip  ·  ${C_RESET}${C_KEY}${C_BOLD}m${C_RESET} ${C_DIM}menu  ·  ${C_RESET}${C_KEY}${C_BOLD}q${C_RESET} ${C_DIM}quit${C_RESET}"
    else
        plain='p pause  ·  s skip  ·  m menu  ·  q quit'
        status="${C_KEY}${C_BOLD}p${C_RESET} ${C_DIM}pause  ·  ${C_RESET}${C_KEY}${C_BOLD}s${C_RESET} ${C_DIM}skip  ·  ${C_RESET}${C_KEY}${C_BOLD}m${C_RESET} ${C_DIM}menu  ·  ${C_RESET}${C_KEY}${C_BOLD}q${C_RESET} ${C_DIM}quit${C_RESET}"
    fi
    pad=$(( (cols - ${#plain}) / 2 )); pad=$(( pad < 0 ? 0 : pad ))
    printf -v line '%*s%s' "$pad" '' "$status"
    frame+="$line${E}[K"$'\n'

    # cursor-home + clear-to-end: redraw mulus tanpa flicker
    printf '%s%s%s' "${E}[H" "$frame" "${E}[0J"
}

draw_focus_recap() {
    # Rounded Focus Recap Card saat sesi fokus selesai.
    # $1 durasi sesi (detik), $2 label sesi berikutnya
    local duration=$1 next_label=$2
    local cols=$TERM_COLS rows=$TERM_LINES
    local card_inner=48
    if (( card_inner + 2 > cols )); then
        card_inner=$(( cols - 2 ))
    fi
    (( card_inner < 36 )) && card_inner=36
    local card_w=$(( card_inner + 2 ))

    local pad pad_s blank_inner hbar
    pad=$(( (cols - card_w) / 2 )); (( pad < 0 )) && pad=0
    printf -v pad_s '%*s' "$pad" ''
    printf -v blank_inner '%*s' "$card_inner" ''
    hbar=${blank_inner// /─}

    local -a body_plain=() body_styled=()
    local clean_task max_task
    clean_task=$(sanitize_field "$SESSION_TASK")
    if [[ -n $clean_task ]]; then
        max_task=$(( card_inner - 15 ))
        (( max_task < 8 )) && max_task=8
        if (( ${#clean_task} > max_task )); then
            clean_task="${clean_task:0:max_task-1}…"
        fi
        body_plain+=("  Task     : $clean_task")
        body_styled+=("  ${C_DIM}Task     :${C_RESET} ${C_WHITE}${C_BOLD}${clean_task}${C_RESET}")
    fi

    if (( ACT_SAMPLES > 0 )); then
        local total_tracked=$(( ACT_ACTIVE_SECS + ACT_IDLE_SECS ))
        local active_pct=100 idle_pct=0
        if (( total_tracked > 0 )); then
            active_pct=$(( ACT_ACTIVE_SECS * 100 / total_tracked ))
            idle_pct=$(( 100 - active_pct ))
        fi
        local sw_word='app switches'
        (( ACT_SWITCHES == 1 )) && sw_word='app switch'
        local act_line="${active_pct}% active · ${ACT_SWITCHES} ${sw_word}"
        body_plain+=("  Activity : $act_line")
        body_styled+=("  ${C_DIM}Activity :${C_RESET} ${C_GREEN}${active_pct}% active${C_RESET}${C_DIM} · ${C_RESET}${C_WHITE}${ACT_SWITCHES} ${sw_word}${C_RESET}")

        local idle_dur idle_line
        idle_dur=$(format_duration_short "$ACT_IDLE_SECS")
        idle_line="${idle_pct}% idle (${idle_dur})"
        body_plain+=("  Idle     : $idle_line")
        if (( ACT_IDLE_SECS > 0 )); then
            body_styled+=("  ${C_DIM}Idle     :${C_RESET} ${C_YELLOW}${idle_pct}% idle${C_RESET} ${C_DIM}(${idle_dur})${C_RESET}")
        else
            body_styled+=("  ${C_DIM}Idle     :${C_RESET} ${C_DIM}${idle_line}${C_RESET}")
        fi

        body_plain+=('')
        body_styled+=('')
        body_plain+=('  Apps used:')
        body_styled+=("  ${C_DIM}Apps used:${C_RESET}")

        local bar_w=$(( card_inner - 30 ))
        (( bar_w > 16 )) && bar_w=16
        (( bar_w < 6 )) && bar_w=6

        local shown=0 secs app app_disp pct filled rest_w b_fill b_rest dur_s i
        while IFS='|' read -r secs app; do
            [[ -n $app ]] || continue
            (( shown >= 5 )) && break
            shown=$(( shown + 1 ))
            app_disp=$app
            if (( ${#app_disp} > 11 )); then
                app_disp="${app_disp:0:10}…"
            fi
            pct=0
            (( total_tracked > 0 )) && pct=$(( secs * 100 / total_tracked ))
            filled=$(( pct * bar_w / 100 ))
            (( filled == 0 && secs > 0 )) && filled=1
            (( filled > bar_w )) && filled=$bar_w
            rest_w=$(( bar_w - filled ))
            b_fill=''
            b_rest=''
            for (( i = 0; i < filled; i++ )); do b_fill+='━'; done
            for (( i = 0; i < rest_w; i++ )); do b_rest+='─'; done
            dur_s=$(format_duration_short "$secs")
            local pl sl
            printf -v pl '    %-11s %s%s  %4s (%3d%%)' "$app_disp" "$b_fill" "$b_rest" "$dur_s" "$pct"
            printf -v sl '    %s%-11s%s %s%s%s%s%s%s  %s%4s%s %s(%3d%%)%s' \
                "$C_WHITE" "$app_disp" "$C_RESET" \
                "$C_BAR" "$b_fill" "$C_RESET" "$C_DIM" "$b_rest" "$C_RESET" \
                "$C_WHITE" "$dur_s" "$C_RESET" "$C_DIM" "$pct" "$C_RESET"
            body_plain+=("$pl")
            body_styled+=("$sl")
        done < <(activity_sorted_apps)
    else
        local dur_label
        if (( duration >= 60 )); then
            dur_label="$(( duration / 60 )) min"
        else
            dur_label="${duration}s"
        fi
        body_plain+=("  All $dur_label of focus logged — nice work!")
        body_styled+=("  ${C_WHITE}All ${dur_label} of focus logged — nice work!${C_RESET}")
        if [[ $TRACKER_BACKEND == off ]]; then
            body_plain+=('  Activity tracking is turned off.')
            body_styled+=("  ${C_DIM}Activity tracking is turned off.${C_RESET}")
        elif [[ $TRACKER_BACKEND == none ]]; then
            body_plain+=('  No desktop window tracker detected.')
            body_styled+=("  ${C_DIM}No desktop window tracker detected.${C_RESET}")
        fi
    fi

    local total_h=$(( ${#body_plain[@]} + 6 ))
    local top_pad=$(( (rows - total_h) / 2 ))
    (( top_pad < 0 )) && top_pad=0
    local frame='' n line
    for (( n = 0; n < top_pad; n++ )); do frame+="${E}[K"$'\n'; done

    local hdr_left='✓ FOCUS COMPLETE' hdr_right
    if (( duration >= 60 )); then
        hdr_right="$(( duration / 60 )) min"
    else
        hdr_right="${duration}s"
    fi
    local mid_dashes=$(( card_inner - ${#hdr_left} - ${#hdr_right} - 6 ))
    (( mid_dashes < 1 )) && mid_dashes=1
    local mid_bar
    printf -v mid_bar '%*s' "$mid_dashes" ''
    mid_bar=${mid_bar// /─}

    printf -v line '%s%s╭─ %s%s%s%s %s %s%s%s ─╮%s' \
        "$pad_s" "$C_BORDER" "$C_TITLE" "$C_BOLD" "$hdr_left" "${C_RESET}${C_BORDER}" \
        "$mid_bar" "$C_WHITE" "$hdr_right" "${C_RESET}${C_BORDER}" "$C_RESET"
    frame+="$line${E}[K"$'\n'

    printf -v line '%s%s│%s%s%s│%s' "$pad_s" "$C_BORDER" "$C_RESET" "$blank_inner" "$C_BORDER" "$C_RESET"
    frame+="$line${E}[K"$'\n'

    local idx rp rp_s
    for (( idx = 0; idx < ${#body_plain[@]}; idx++ )); do
        rp=$(( card_inner - ${#body_plain[idx]} ))
        (( rp < 0 )) && rp=0
        printf -v rp_s '%*s' "$rp" ''
        printf -v line '%s%s│%s%s%s%s│%s' \
            "$pad_s" "$C_BORDER" "$C_RESET" "${body_styled[idx]}" "$rp_s" "$C_BORDER" "$C_RESET"
        frame+="$line${E}[K"$'\n'
    done

    printf -v line '%s%s│%s%s%s│%s' "$pad_s" "$C_BORDER" "$C_RESET" "$blank_inner" "$C_BORDER" "$C_RESET"
    frame+="$line${E}[K"$'\n'
    printf -v line '%s%s╰%s╯%s' "$pad_s" "$C_BORDER" "$hbar" "$C_RESET"
    frame+="$line${E}[K"$'\n'
    frame+="${E}[K"$'\n'

    local plain status
    plain="Enter $next_label  ·  m menu  ·  t stats  ·  d durations  ·  q quit"
    status="${C_KEY}${C_BOLD}Enter${C_RESET} ${C_WHITE}${next_label}${C_RESET}${C_DIM}  ·  ${C_RESET}${C_KEY}${C_BOLD}m${C_RESET} ${C_DIM}menu  ·  ${C_RESET}${C_KEY}${C_BOLD}t${C_RESET} ${C_DIM}stats  ·  ${C_RESET}${C_KEY}${C_BOLD}d${C_RESET} ${C_DIM}durations  ·  ${C_RESET}${C_KEY}${C_BOLD}q${C_RESET} ${C_DIM}quit${C_RESET}"
    pad=$(( (cols - ${#plain}) / 2 )); (( pad < 0 )) && pad=0
    printf -v line '%*s%s' "$pad" '' "$status"
    frame+="$line${E}[K"$'\n'

    printf '%s%s%s' "${E}[H" "$frame" "${E}[0J"
}

draw_message() {
    # Layar pesan sederhana (dipakai di antar-sesi): $1 judul, $2 pesan, $3 prompt
    local title=$1 msg=$2 prompt=$3
    local cols=$TERM_COLS rows=$TERM_LINES
    local frame='' pad line n
    local top_pad=$(( (rows - 6) / 2 ))
    top_pad=$(( top_pad < 0 ? 0 : top_pad ))
    for (( n = 0; n < top_pad; n++ )); do frame+="${E}[K"$'\n'; done

    pad=$(( (cols - ${#title}) / 2 )); pad=$(( pad < 0 ? 0 : pad ))
    printf -v line '%*s%s%s%s%s' "$pad" '' "$C_TITLE" "$C_BOLD" "$title" "$C_RESET"
    frame+="$line${E}[K"$'\n'
    frame+="${E}[K"$'\n'

    pad=$(( (cols - ${#msg}) / 2 )); pad=$(( pad < 0 ? 0 : pad ))
    printf -v line '%*s%s%s%s' "$pad" '' "$C_WHITE" "$msg" "$C_RESET"
    frame+="$line${E}[K"$'\n'
    frame+="${E}[K"$'\n'

    pad=$(( (cols - ${#prompt}) / 2 )); pad=$(( pad < 0 ? 0 : pad ))
    printf -v line '%*s%s%s%s' "$pad" '' "$C_DIM" "$prompt" "$C_RESET"
    frame+="$line${E}[K"$'\n'

    printf '%s%s%s' "${E}[H" "$frame" "${E}[0J"
}

# Baris-baris overlay generik; diisi caller sebelum memanggil draw_overlay()
OVERLAY_LINES=()

draw_overlay() {
    # Overlay layar penuh: $1 judul, $2 prompt (kosong = tanpa prompt)
    # Judul dan prompt di tengah layar; baris konten disusun sebagai satu
    # blok rata kiri yang diletakkan di tengah (lebar blok = baris terpanjang).
    local title=$1 prompt=$2
    local cols=$TERM_COLS rows=$TERM_LINES
    local frame='' pad line n txt
    local content_h=$(( ${#OVERLAY_LINES[@]} + 4 ))
    local top_pad=$(( (rows - content_h) / 2 ))
    top_pad=$(( top_pad < 0 ? 0 : top_pad ))
    for (( n = 0; n < top_pad; n++ )); do frame+="${E}[K"$'\n'; done

    pad=$(( (cols - ${#title}) / 2 )); pad=$(( pad < 0 ? 0 : pad ))
    printf -v line '%*s%s%s%s%s' "$pad" '' "$C_TITLE" "$C_BOLD" "$title" "$C_RESET"
    frame+="$line${E}[K"$'\n'
    frame+="${E}[K"$'\n'

    # Hitung lebar blok konten lalu rata-kan bloknya di tengah layar
    local block_w=0 block_pad block_pad_s
    for txt in "${OVERLAY_LINES[@]}"; do
        if (( ${#txt} > block_w )); then block_w=${#txt}; fi
    done
    block_pad=$(( (cols - block_w) / 2 ))
    block_pad=$(( block_pad < 0 ? 0 : block_pad ))
    printf -v block_pad_s '%*s' "$block_pad" ''
    for txt in "${OVERLAY_LINES[@]}"; do
        printf -v line '%s%s%s%s' "$block_pad_s" "$C_WHITE" "$txt" "$C_RESET"
        frame+="$line${E}[K"$'\n'
    done

    frame+="${E}[K"$'\n'
    if [[ -n $prompt ]]; then
        pad=$(( (cols - ${#prompt}) / 2 )); pad=$(( pad < 0 ? 0 : pad ))
        printf -v line '%*s%s%s%s' "$pad" '' "$C_DIM" "$prompt" "$C_RESET"
        frame+="$line${E}[K"$'\n'
    fi

    printf '%s%s%s' "${E}[H" "$frame" "${E}[0J"
}

