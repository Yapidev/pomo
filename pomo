        OVERLAY_LINES=()
        for (( i = 0; i < ${#items[@]}; i++ )); do
            if (( i == sel )); then line="> ${items[i]}"; else line="  ${items[i]}"; fi
            OVERLAY_LINES+=("$line")
        done
        draw_overlay 'MENU' '↑/↓ select · Enter choose · b back'

        key=''
        if ! read_key key; then
            MENU_RESULT='back'   # EOF di stdin
            return
        fi
        case $key in
            UP)
                j=$sel
                while :; do
                    j=$(( (j - 1 + ${#items[@]}) % ${#items[@]} ))
                    [[ -n ${actions[j]} ]] && break
                done
                sel=$j
                ;;
            DOWN)
                j=$sel
                while :; do
                    j=$(( (j + 1) % ${#items[@]} ))
                    [[ -n ${actions[j]} ]] && break
                done
                sel=$j
                ;;
            '')    MENU_RESULT=${actions[sel]:-} ;;   # Enter: item terpilih (bisa kosong = abaikan)
            1|f|F) MENU_RESULT='focus' ;;
            2|w|W) MENU_RESULT='short_break' ;;
            3)     MENU_RESULT='long_break' ;;
            h|H|'?') show_help_overlay ;;
            t|T)   show_stats_overlay ;;
            d|D)   show_duration_config_overlay ;;
            c|C)   cycle_theme
                   # Terapkan ulang warna mode agar menu (dan timer
                   # setelahnya) langsung memakai tema yang baru.
                   set_mode_colors "$CURRENT_MODE" ;;
            b|B|m|M) MENU_RESULT='back' ;;
            q|Q)   MENU_RESULT='quit' ;;
        esac
        if [[ -n $MENU_RESULT ]]; then
            return
        fi
    done
}

# ================================ TIMER =====================================

run_timer() {
    # $1 durasi detik, $2 judul mode
    # $3 (opsional) sisa detik awal — dipakai "pomo resume" untuk mulai
    #     dari sisa waktu; progress bar tetap dihitung dari durasi penuh $1.
    # Return: 0 = selesai, 1 = user quit, 2 = user skip,
    #         3 = ganti ke short break (menu), 4 = ganti ke long break (menu),
    #         5 = ganti ke focus (menu)
    local total=$1 label=$2 start=${3:-$1}
    local end now remaining frozen paused=0 key rc
    local last_frame=''
    local menu_was_paused=0

    end=$(( $(now) + start ))
    frozen=$start
    write_state "$end" "$total" 0 "$start"

    # Animasi intro: digit besar menyala piksel demi piksel (~0.35s),
    # hanya di terminal interaktif yang cukup besar.
    if (( ANIM_ENABLED && INTERACTIVE )) \
        && (( TERM_COLS >= MIN_COLS && TERM_LINES >= MIN_ROWS )); then
        local fr
        for fr in 30 55 80 100; do
            draw_ui "$frozen" "$total" "$label" 0 "$fr"
            sleep 0.09
        done
        last_frame=''
    fi

    while :; do
        if (( paused )); then
            remaining=$frozen
        else
            now=$(now)
            remaining=$(( end - now ))
            if (( remaining <= 0 )); then
                draw_ui 0 "$total" "$label" 0
                return 0
            fi
            frozen=$remaining
        fi

        # Gambar ulang hanya saat ada perubahan (detik/pause/resize)
        local frame_key="$remaining-$paused-${TERM_COLS}x${TERM_LINES}"
        if [[ $frame_key != "$last_frame" || $RESIZED == 1 ]]; then
            draw_ui "$remaining" "$total" "$label" "$paused"
            # Status untuk "pomo status" ikut detik/pause yang tampil
            write_state "$end" "$total" "$paused" "$remaining"
            last_frame=$frame_key
            RESIZED=0
        fi

        # Baca input tanpa menghentikan loop utama
        key=''
        if (( INTERACTIVE )); then
            # rc: 0 = ada tombol, >128 = timeout read, 1 = EOF di stdin
            rc=0
            IFS= read -r -s -n 1 -t 0.1 key || rc=$?
            if (( rc > 0 && rc <= 128 )); then
                # stdin tertutup (EOF): jatuh ke mode non-interaktif
                INTERACTIVE=0
                sleep 1
                continue
            fi
        else
            sleep 1
        fi

        case $key in
            q|Q)
                # Konfirmasi quit: salah tekan tidak langsung keluar dari sesi
                OVERLAY_LINES=(
                    'Quit pomo?'
                    ''
                    'The current session ends — nothing is logged.'
                    ''
                    '[q] Quit    ·    any other key to go back'
                )
                draw_overlay 'QUIT' ''
                local qk=''
                if ! read_key qk; then
                    return 1   # EOF di stdin = quit
                fi
                if [[ $qk == q || $qk == Q ]]; then
                    return 1
                fi
                last_frame=''   # paksa redraw timer setelah overlay
                ;;
            p|P)
                if (( paused )); then
                    paused=0
                    end=$(( $(now) + frozen ))
                else
                    paused=1
                fi
                ;;
            s|S)
                return 2
                ;;
            m|M)
                # Buka menu; bekukan timer selama menu terbuka
                menu_was_paused=$paused
                paused=1
                MENU_RESULT=''
                open_menu
                if (( THEME_CHANGED )); then
                    # Tema berganti dari menu: terapkan ulang warna mode
                    set_mode_colors "$CURRENT_MODE"
                    THEME_CHANGED=0
                fi
                case $MENU_RESULT in
                    focus)       return 5 ;;
                    short_break) return 3 ;;
                    long_break)  return 4 ;;
                    quit)        return 1 ;;
                    back)
                        # Lanjutkan sesi dengan sisa waktu yang sama
                        if (( menu_was_paused == 0 )); then
                            paused=0
                            end=$(( $(now) + frozen ))
                        fi
                        # Paksa redraw timer karena layar berisi overlay menu
                        last_frame=''
                        ;;
                esac
                ;;
        esac
    done
}

# ============================ ALUR SESI / SIKLUS ============================

prompt_continue() {
    # $1 judul, $2 pesan, $3 label mode berikutnya
    # Return: 0 = lanjut, 1 = berhenti.
    # Bila user memilih sesi lewat menu di layar ini, mode berikutnya
    # di-override lewat global PROMPT_NEXT_MODE.
    if (( ! INTERACTIVE )); then
        # Mode non-interaktif (stdin bukan tty): sesi tunggal lalu selesai.
        printf '%s\n' "$1 — $2"
        return 1
    fi

    local ans=''
    while :; do
        draw_message "$1" "$2" \
            "Press [Enter] to start $3  ·  [m] menu  ·  [t] stats  ·  [d] durations  ·  [q] to quit"
        ans=''
        if ! read_key ans; then
            return 1   # EOF di stdin
        fi
        case $ans in
            '') return 0 ;;       # Enter ditekan
            q|Q) return 1 ;;
            m|M)
                MENU_RESULT=''
                open_menu
                case $MENU_RESULT in
                    focus|short_break|long_break)
                        PROMPT_NEXT_MODE=$MENU_RESULT
                        return 0
                        ;;
                    quit) return 1 ;;
                    back) : ;;    # tampilkan lagi layar konfirmasi
                esac
                ;;
            t|T) show_stats_overlay ;;
            d|D) show_duration_config_overlay ;;
        esac
    done
}

mode_label() {
    case $1 in
        focus)        echo 'FOCUS SESSION' ;;
        short_break)  echo 'SHORT BREAK' ;;
        long_break)   echo 'LONG BREAK' ;;
    esac
}

mode_duration() {
    case $1 in
        focus)        echo "$FOCUS_SECONDS" ;;
        short_break)  echo "$SHORT_BREAK_SECONDS" ;;
        long_break)   echo "$LONG_BREAK_SECONDS" ;;
    esac
}

run_cycle() {
    # $1 mode awal: focus|short_break|long_break
    # Jika RESUME_REMAINING > 0 (dari "pomo resume"), sesi pertama dimulai
    # dari sisa waktu itu; sesi-sesi berikutnya normal.
    local mode=$1
    local focus_done=0   # jumlah fokus selesai dalam siklus ini
    local resume_remaining=${RESUME_REMAINING:-0}
    RESUME_REMAINING=0
    local rc completed duration label next next_label msg

    while :; do
        duration=$(mode_duration "$mode")
        # Sisa resume tidak boleh melebihi durasi mode (state basi/rusak)
        (( resume_remaining > duration )) && resume_remaining=$duration
        label=$(mode_label "$mode")
        CURRENT_MODE=$mode
        set_mode_colors "$mode"

        # Indikator progres siklus untuk layar timer (● = fokus selesai di
        # siklus berjalan; saat long break semua terisi).
        local fd dots='' di
        if [[ $mode == long_break ]]; then
            fd=$CYCLES_BEFORE_LONG
        else
            fd=$(( focus_done % CYCLES_BEFORE_LONG ))
        fi
        for (( di = 0; di < fd; di++ )); do dots+='●'; done
        for (( di = fd; di < CYCLES_BEFORE_LONG; di++ )); do dots+='○'; done
        CYCLE_DOTS=$dots

        rc=0
        if (( resume_remaining )); then
            run_timer "$duration" "$label" "$resume_remaining" || rc=$?
            resume_remaining=0
        else
            run_timer "$duration" "$label" || rc=$?
        fi
        clear_state
        case $rc in
            1)
                return 0    # quit
                ;;
            3)
                mode=short_break   # ganti mode via menu: sesi ditinggalkan, tanpa log
                continue
                ;;
            4)
                mode=long_break
                continue
                ;;
            5)
                mode=focus
                continue
                ;;
        esac
        completed=$(( rc == 0 ? 1 : 0 ))

        if (( completed )); then
            case $mode in
                focus)
                    notify 'Focus session complete' \
                        "Nice work — $(( duration / 60 )) minutes of focus logged."
                    play_speaker "$FOCUS_SOUND"
                    log_session focus "$duration"
                    focus_done=$(( focus_done + 1 ))
                    ;;
                short_break)
                    notify 'Short break over' 'Ready for another focus session?'
                    play_speaker "$BREAK_SOUND"
                    log_session short_break "$duration"
                    ;;
                long_break)
                    notify 'Long break over' 'Refreshed — time to get back to work.'
                    play_speaker "$BREAK_SOUND"
                    log_session long_break "$duration"
                    ;;
            esac
            msg="$label finished — nothing skipped, all $(( duration / 60 )) min logged."
        else
            msg="$label skipped — nothing was logged."
        fi

        # Tentukan mode berikutnya: fokus -> break (panjang tiap ke-4), break -> fokus
        if [[ $mode == focus ]]; then
            if (( focus_done % CYCLES_BEFORE_LONG == 0 )); then
                next=long_break
            else
                next=short_break
            fi
        else
            next=focus
        fi
        next_label=$(mode_label "$next")

        if (( completed )); then
            if ! prompt_continue 'SESSION COMPLETE' "$msg" "$next_label"; then
                return 0
            fi
        else
            if ! prompt_continue 'SESSION SKIPPED' "$msg" "$next_label"; then
                return 0
            fi
        fi
        # Mode berikutnya bisa di-override dari menu di layar antar-sesi
        if [[ -n ${PROMPT_NEXT_MODE:-} ]]; then
            next=$PROMPT_NEXT_MODE
            PROMPT_NEXT_MODE=''
            next_label=$(mode_label "$next")
        fi
        mode=$next
    done
}

start_session() {
    # $1 mode awal
    validate_durations
    init_terminal
    
    # Show confirmation in UI for focus mode
    if [[ "$1" == "focus" && "${2:-}" == "confirm" ]]; then
        local label=$(mode_label "$1")
        local duration=$(mode_duration "$1")
        local mins=$(( duration / 60 ))
        
        draw_message "START CONFIRMATION" "Start $label ($mins min)?" "Press [Enter] to start  ·  [q] to quit"
        
        local ans=''
        while :; do
            ans=''
            if ! IFS= read -r -s -n 1 ans; then
                cleanup
                exit 0
            fi
            case $ans in
                '') 
                    break  # Enter ditekan - lanjutkan
                    ;;
                q|Q)
                    cleanup
                    printf "Sesi fokus belum dimulai.\n"
                    exit 0
                    ;;
            esac
        done
    fi
    
    run_cycle "$1"
}

# ================================= STATS ====================================

# Riwayat sesi dibaca sekali ke array global per tanggal:
# FOCUS_COUNT (jumlah sesi), FOCUS_SECS (total detik), BREAK_COUNT (jumlah break)
declare -gA FOCUS_COUNT=() FOCUS_SECS=() BREAK_COUNT=()

read_history() {
    # Return: 0 = file riwayat ada dan terbaca, 1 = belum ada
    FOCUS_COUNT=()
    FOCUS_SECS=()
    BREAK_COUNT=()
    if [[ ! -f $HISTORY_FILE ]]; then
        return 1
    fi
    local d t s
    while IFS='|' read -r d t s || [[ -n ${d:-} ]]; do
        if [[ -z ${d:-} ]]; then continue; fi
        if [[ ! $d =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then continue; fi
        if [[ ! $s =~ ^[0-9]+$ ]]; then continue; fi
        case $t in
            focus)
                FOCUS_COUNT[$d]=$(( ${FOCUS_COUNT[$d]:-0} + 1 ))
                FOCUS_SECS[$d]=$(( ${FOCUS_SECS[$d]:-0} + s ))
                ;;
            short_break|long_break)
                BREAK_COUNT[$d]=$(( ${BREAK_COUNT[$d]:-0} + 1 ))
                ;;
        esac
    done < "$HISTORY_FILE"
    return 0
}

show_stats() {
    if ! read_history; then
        printf 'No sessions recorded yet.\n'
        printf 'Run "pomo" to start your first focus session.\n'
        printf 'History will be saved in %s\n' "$HISTORY_FILE"
        return 0
    fi

    local today
    today=$(date +%F)

    printf '%sPomodoro Statistics%s\n' "$C_BOLD" "$C_RESET"
    printf '\n'
    printf '%sToday — %s%s\n' "$C_DIM" "$today" "$C_RESET"
    printf '  Focus sessions : %s%s%s\n' "$C_GREEN" "${FOCUS_COUNT[$today]:-0}" "$C_RESET"
    printf '  Focus minutes  : %s%s%s\n' "$C_GREEN" "$(( ${FOCUS_SECS[$today]:-0} / 60 ))" "$C_RESET"
    printf '  Breaks taken   : %s%s%s\n' "$C_CYAN" "${BREAK_COUNT[$today]:-0}" "$C_RESET"

    printf '\n'
    printf '%sLast 7 days%s\n' "$C_BOLD" "$C_RESET"
    printf '  %-12s %8s %8s\n' 'Date' 'Sessions' 'Minutes'

    # Skala bar: berdasarkan hari terproduktif dalam 7 hari terakhir
    local max_minutes=0 day mins i
    for (( i = 6; i >= 0; i-- )); do
        day=$(date -d "-$i day" +%F)
        mins=$(( ${FOCUS_SECS[$day]:-0} / 60 ))
        if (( mins > max_minutes )); then max_minutes=$mins; fi
    done

    local total_sessions=0 total_minutes=0 bar='' j filled
    for (( i = 6; i >= 0; i-- )); do
        day=$(date -d "-$i day" +%F)
        mins=$(( ${FOCUS_SECS[$day]:-0} / 60 ))
        total_sessions=$(( total_sessions + ${FOCUS_COUNT[$day]:-0} ))
        total_minutes=$(( total_minutes + mins ))

        bar=''
        if (( max_minutes > 0 )); then
            filled=$(( mins * 20 / max_minutes ))
            for (( j = 0; j < filled; j++ )); do bar+='▓'; done
        fi
        printf '  %s%-12s%s %s%8s%s %s%8s%s  %s%s%s\n' \
            "$C_CYAN" "$day" "$C_RESET" \
            "$C_GREEN" "${FOCUS_COUNT[$day]:-0}" "$C_RESET" \
            "$C_GREEN" "$mins" "$C_RESET" \
            "$C_BAR" "$bar" "$C_RESET"
    done

    printf '\n'
    printf '%s7-day total:%s %d sessions · %d minutes focused\n' \
        "$C_DIM" "$C_RESET" "$total_sessions" "$total_minutes"
}

