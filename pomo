read_key() {
    # Baca satu tombol; hasil ditulis ke variabel bernama $1.
    # Escape sequence diterjemahkan: arrow keys menjadi UP/DOWN/LEFT/RIGHT,
    # Esc murni (atau escape sequence lain) menjadi ESC (dibedakan dari Enter
    # yang menghasilkan string kosong '').
    # Return: 1 pada EOF, 0 jika ada tombol.
    local __var=$1 ch rest
    ch=''
    if ! IFS= read -r -s -n 1 ch; then
        return 1
    fi
    if [[ $ch == $'\x1b' ]]; then
        rest=''
        IFS= read -r -s -n 2 -t 0.05 rest || true
        case $rest in
            '[A') ch='UP' ;;
            '[B') ch='DOWN' ;;
            '[C') ch='RIGHT' ;;
            '[D') ch='LEFT' ;;
            *)    ch='ESC' ;;
        esac
    fi
    printf -v "$__var" '%s' "$ch"
    return 0
}

show_stats_overlay() {
    # Ringkasan statistik untuk overlay: hari ini + bar chart 7 hari
    # (mengikuti tampilan "pomo stats" di CLI).
    local today ts=0 tm=0 i day mins max_minutes=0 bar j filled have_history
    today=$(date +%F)
    # Baca riwayat DULU: bagian "Today" memakai FOCUS_COUNT & co.
    if read_history; then have_history=1; else have_history=0; fi
    OVERLAY_LINES=(
        "Today — $today"
        "  Focus sessions : ${FOCUS_COUNT[$today]:-0}"
        "  Focus minutes  : $(( ${FOCUS_SECS[$today]:-0} / 60 ))"
        "  Breaks taken   : ${BREAK_COUNT[$today]:-0}"
    )
    if (( have_history )); then
        for (( i = 6; i >= 0; i-- )); do
            day=$(date -d "-$i day" +%F)
            mins=$(( ${FOCUS_SECS[$day]:-0} / 60 ))
            (( mins > max_minutes )) && max_minutes=$mins
        done
        OVERLAY_LINES+=('' 'Last 7 days:')
        for (( i = 6; i >= 0; i-- )); do
            day=$(date -d "-$i day" +%F)
            ts=$(( ts + ${FOCUS_COUNT[$day]:-0} ))
            tm=$(( tm + ${FOCUS_SECS[$day]:-0} / 60 ))
            mins=$(( ${FOCUS_SECS[$day]:-0} / 60 ))
            bar=''
            if (( max_minutes > 0 )); then
                filled=$(( mins * 20 / max_minutes ))
                for (( j = 0; j < filled; j++ )); do bar+='▓'; done
            fi
            OVERLAY_LINES+=("  $day  ${FOCUS_COUNT[$day]:-0} sess  ${mins} min  $bar")
        done
        OVERLAY_LINES+=('' "7-day total: $ts sessions · $tm minutes")
    else
        OVERLAY_LINES+=('' 'No sessions recorded yet.')
    fi
    draw_overlay 'STATS' 'Press any key to go back'
    local k=''
    read_key k || true
}

show_duration_config_overlay() {
    # Overlay untuk mengustom durasi sesi.
    # Navigasi: ↑/↓ pilih + Enter jalankan, ←/→ ubah ±1 menit, atau tombol langsung (f/s/l/r/a/b/Esc).
    local sel=0 i j line key fm sm lm
    local -a items actions
    while :; do
        fm=$(( FOCUS_SECONDS / 60 ))
        sm=$(( SHORT_BREAK_SECONDS / 60 ))
        lm=$(( LONG_BREAK_SECONDS / 60 ))

        items=(
            "$(printf '[f] Focus session       : %3d min' "$fm")"
            "$(printf '[s] Short break         : %3d min' "$sm")"
            "$(printf '[l] Long break          : %3d min' "$lm")"
            ''
            '[r] Reset to defaults (25/5/15 min)'
            '[a] Save to config file'
            '[b] Back to menu'
        )
        actions=( focus short long '' reset save back )

        OVERLAY_LINES=()
        for (( i = 0; i < ${#items[@]}; i++ )); do
            if (( i == sel )); then
                line="> ${items[i]}"
                case ${actions[i]} in
                    focus|short|long) line+='  ◀ ▶' ;;
                esac
            else
                line="  ${items[i]}"
            fi
            OVERLAY_LINES+=("$line")
        done
        draw_overlay 'CUSTOMIZE DURATIONS' '↑/↓ select · ←/→ ±1 min · Enter choose · b back'

        key=''
        if ! read_key key; then
            return
        fi

        case $key in
            UP)
                j=$sel
                while :; do
                    j=$(( (j - 1 + ${#items[@]}) % ${#items[@]} ))
                    [[ -n ${actions[j]} ]] && break
                done
                sel=$j
                ;;
            DOWN)
                j=$sel
                while :; do
                    j=$(( (j + 1) % ${#items[@]} ))
                    [[ -n ${actions[j]} ]] && break
                done
                sel=$j
                ;;
            LEFT)
                case ${actions[sel]} in
                    focus) (( fm > 1 )) && FOCUS_SECONDS=$(( (fm - 1) * 60 )) ;;
                    short) (( sm > 1 )) && SHORT_BREAK_SECONDS=$(( (sm - 1) * 60 )) ;;
                    long)  (( lm > 1 )) && LONG_BREAK_SECONDS=$(( (lm - 1) * 60 )) ;;
                esac
                ;;
            RIGHT)
                case ${actions[sel]} in
                    focus) (( fm < 120 )) && FOCUS_SECONDS=$(( (fm + 1) * 60 )) ;;
                    short) (( sm < 120 )) && SHORT_BREAK_SECONDS=$(( (sm + 1) * 60 )) ;;
                    long)  (( lm < 120 )) && LONG_BREAK_SECONDS=$(( (lm + 1) * 60 )) ;;
                esac
                ;;
            '')
                case ${actions[sel]} in
                    focus)
                        prompt_for_duration "Focus session" "$fm"
                        FOCUS_SECONDS=$(( DURATION_RESULT * 60 ))
                        ;;
                    short)
                        prompt_for_duration "Short break" "$sm"
                        SHORT_BREAK_SECONDS=$(( DURATION_RESULT * 60 ))
                        ;;
                    long)
                        prompt_for_duration "Long break" "$lm"
                        LONG_BREAK_SECONDS=$(( DURATION_RESULT * 60 ))
                        ;;
                    reset)
                        FOCUS_SECONDS=1500
                        SHORT_BREAK_SECONDS=300
                        LONG_BREAK_SECONDS=900
                        ;;
                    save)
                        save_duration_config
                        ;;
                    back)
                        return
                        ;;
                esac
                ;;
            f|F)
                sel=0
                prompt_for_duration "Focus session" "$fm"
                FOCUS_SECONDS=$(( DURATION_RESULT * 60 ))
                ;;
            s|S)
                sel=1
                prompt_for_duration "Short break" "$sm"
                SHORT_BREAK_SECONDS=$(( DURATION_RESULT * 60 ))
                ;;
            l|L)
                sel=2
                prompt_for_duration "Long break" "$lm"
                LONG_BREAK_SECONDS=$(( DURATION_RESULT * 60 ))
                ;;
            r|R)
                sel=4
                FOCUS_SECONDS=1500
                SHORT_BREAK_SECONDS=300
                LONG_BREAK_SECONDS=900
                ;;
            a|A)
                sel=5
                save_duration_config
                ;;
            b|B|ESC)
                return
                ;;
        esac
    done
}

prompt_for_duration() {
    # $1 = label, $2 = current value in minutes.
    # Result is returned in the global DURATION_RESULT; do not use command
    # substitution here because draw_overlay writes to the terminal.
    local label=$1 current=$2 input='' ch rc k redraw=1
    DURATION_RESULT=$current

    while :; do
        if (( redraw )); then
            OVERLAY_LINES=(
                "Set $label duration (minutes):"
                "Current: $current min"
                ''
                "Enter new duration (1-120): $input"
                ''
                '[Enter to accept, Esc to cancel]'
            )
            draw_overlay "$label" ''
            redraw=0
        fi

        ch=''
        if IFS= read -r -s -n 1 -t 0.1 ch; then
            if [[ -z $ch ]]; then
                # Enter: accept the value, or keep the current value if empty.
                if [[ -z $input ]]; then
                    DURATION_RESULT=$current
                    return 0
                elif [[ $input =~ ^[0-9]+$ ]] && (( 10#$input >= 1 && 10#$input <= 120 )); then
                    DURATION_RESULT=$((10#$input))
                    return 0
                else
                    OVERLAY_LINES=(
                        'Invalid input!'
                        'Enter a whole number between 1 and 120.'
                        ''
                        "Your input: $input"
                    )
                    draw_overlay 'ERROR' 'Press any key to continue'
                    while :; do
                        k=''
                        if IFS= read -r -s -n 1 -t 0.1 k; then
                            break
                        else
                            rc=$?
                            (( rc > 128 )) && continue
                            break
                        fi
                    done
                    input=''
                    redraw=1
                fi
            else
                case $ch in
                    $'\x1b')
                        local rest=''
                        IFS= read -r -s -n 2 -t 0.05 rest || true
                        if [[ -z $rest ]]; then
                            DURATION_RESULT=$current
                            return 0
                        fi
                        ;;
                    $'\x7f'|$'\b')
                        input=${input%?}
                        redraw=1
                        ;;
                    [0-9])
                        if (( ${#input} < 3 )); then
                            input+=$ch
                            redraw=1
                        fi
                        ;;
                esac
            fi
        else
            rc=$?
            if (( rc > 128 )); then
                continue
            fi
            # EOF or terminal input error: safely retain the current duration.
            DURATION_RESULT=$current
            return 0
        fi
    done
}
save_duration_config() {
    mkdir -p "$CONFIG_DIR"
    local tmp
    tmp=$(mktemp "$CONFIG_DIR/.pomo.conf.XXXXXX") || die "cannot create a temporary config file"
    if [[ -f $CONFIG_FILE ]]; then
        local line key seen_f=0 seen_s=0 seen_l=0
        {
            while IFS= read -r line || [[ -n $line ]]; do
                if [[ ! $line =~ ^[[:space:]]*# && $line == *=* ]]; then
                    key=${line%%=*}
                    key=${key//$'\t'/}; key=${key// /}
                    key=${key^^}
                    case $key in
                        FOCUS_SECONDS)
                            if (( ! seen_f )); then
                                printf 'FOCUS_SECONDS=%s\n' "$FOCUS_SECONDS"
                                seen_f=1
                            fi
                            continue
                            ;;
                        SHORT_BREAK_SECONDS)
                            if (( ! seen_s )); then
                                printf 'SHORT_BREAK_SECONDS=%s\n' "$SHORT_BREAK_SECONDS"
                                seen_s=1
                            fi
                            continue
                            ;;
                        LONG_BREAK_SECONDS)
                            if (( ! seen_l )); then
                                printf 'LONG_BREAK_SECONDS=%s\n' "$LONG_BREAK_SECONDS"
                                seen_l=1
                            fi
                            continue
                            ;;
                    esac
                fi
                printf '%s\n' "$line"
            done < "$CONFIG_FILE"
            (( seen_f )) || printf 'FOCUS_SECONDS=%s\n' "$FOCUS_SECONDS"
            (( seen_s )) || printf 'SHORT_BREAK_SECONDS=%s\n' "$SHORT_BREAK_SECONDS"
            (( seen_l )) || printf 'LONG_BREAK_SECONDS=%s\n' "$LONG_BREAK_SECONDS"
        } > "$tmp"
    else
        cat > "$tmp" <<EOF
# Pomodoro timer configuration
# Custom durations set via UI
FOCUS_SECONDS=$FOCUS_SECONDS
SHORT_BREAK_SECONDS=$SHORT_BREAK_SECONDS
LONG_BREAK_SECONDS=$LONG_BREAK_SECONDS
EOF
    fi
    mv -f "$tmp" "$CONFIG_FILE"

    OVERLAY_LINES=(
        "Configuration saved!"
        "File: $CONFIG_FILE"
        ''
        "New durations will be used for future sessions."
    )
    draw_overlay 'SAVED' 'Press any key to continue'
    local k=''
    read_key k || true
}

