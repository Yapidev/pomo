# ================================= UPDATE ===================================

resolve_self() {
    # Path absolut script ini, mengikuti symlink (mis. /usr/local/bin/pomo)
    local self=${BASH_SOURCE[0]:-$0}
    local resolved
    if resolved=$(readlink -f "$self" 2>/dev/null) && [[ -n $resolved ]]; then
        self=$resolved
    fi
    printf '%s' "$self"
}

self_update() {
    # $1 = path script ini. Unduh versi terbaru dari GitHub lalu timpa diri
    # sendiri secara atomik (file baru ditulis ke temp, lalu di-mv ke atasnya).
    local self=$1
    local tmp new_version

    if [[ ! -w $self ]]; then
        die "cannot update: '$self' is not writable" \
            "Re-run with sudo, or reinstall into a directory you own (see README)."
    fi

    tmp=$(mktemp) || die "cannot create a temporary file"

    if command -v curl >/dev/null 2>&1; then
        if ! curl -fsSL "$POMO_RAW_URL" -o "$tmp"; then
            rm -f "$tmp"
            die "download failed: $POMO_RAW_URL"
        fi
    elif command -v wget >/dev/null 2>&1; then
        if ! wget -qO "$tmp" "$POMO_RAW_URL"; then
            rm -f "$tmp"
            die "download failed: $POMO_RAW_URL"
        fi
    else
        rm -f "$tmp"
        die "updating needs curl or wget installed"
    fi

    # Validasi hasil unduhan: harus berisi baris POMO_VERSION
    new_version=$(sed -n 's/^readonly POMO_VERSION="\([^"]*\)"$/\1/p' "$tmp" | head -n 1)
    if [[ -z $new_version ]]; then
        rm -f "$tmp"
        die "downloaded file does not look like pomo (POMO_VERSION not found)"
    fi

    if [[ $new_version == "$POMO_VERSION" ]]; then
        rm -f "$tmp"
        printf 'pomo %s — already up to date.\n' "$POMO_VERSION"
        return 0
    fi

    chmod +x "$tmp"
    if ! mv -f "$tmp" "$self"; then
        rm -f "$tmp"
        die "failed to replace '$self'"
    fi
    printf 'Updated pomo %s -> %s\n' "$POMO_VERSION" "$new_version"
}

# ================================== MAIN ====================================

main() {
    load_theme
    load_config
    local cmd=${1:-}
    case $cmd in
        '')
            start_session focus confirm
            ;;
        start)
            start_session focus
            ;;
        -w|--short)
            start_session short_break
            ;;
        -W|--long)
            start_session long_break
            ;;
        resume)
            resume_session
            ;;
        stats)
            show_stats
            ;;
        status)
            show_status "${2:-}"
            ;;
        config)
            show_config
            ;;
        update)
            self_update "$(resolve_self)"
            ;;
        theme|themes)
            if [[ -n ${2:-} ]]; then
                if ! theme_valid "$2"; then
                    die "unknown theme: '$2'" "Available themes: ${THEME_NAMES[*]}"
                fi
                THEME_NAME=$2
                save_theme
                printf 'Theme set to %s (saved in %s).\n' "$THEME_NAME" "$THEME_FILE"
            else
                show_theme
            fi
            ;;
        -h|--help|help)
            show_help
            ;;
        -v|--version|version)
            show_version
            ;;
        *)
            die "unknown command or option: '$cmd'" "Try 'pomo --help' for usage information."
            ;;
    esac
}

