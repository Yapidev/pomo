read_key() {
    # Baca satu tombol; hasil ditulis ke variabel bernama $1.
    # Escape sequence diterjemahkan: arrow keys menjadi UP/DOWN/LEFT/RIGHT.
    # Return: 1 pada EOF, 0 jika ada tombol (Esc murni menghasilkan string kosong).
    local __var=$1 ch rest
    ch=''
    if ! IFS= read -r -s -n 1 ch; then
        return 1
    fi
    if [[ $ch == $'\x1b' ]]; then
        rest=''
        IFS= read -r -s -n 2 -t 0.05 rest || true
        case $rest in
            '[A') ch='UP' ;;
            '[B') ch='DOWN' ;;
            '[C') ch='RIGHT' ;;
            '[D') ch='LEFT' ;;
            *)    ch='' ;;
        esac
    fi
    printf -v "$__var" '%s' "$ch"
    return 0
}

show_stats_overlay() {
    # Ringkasan statistik untuk overlay: hari ini + bar chart 7 hari
    # (mengikuti tampilan "pomo stats" di CLI).
    local today ts=0 tm=0 i day mins max_minutes=0 bar j filled
    today=$(date +%F)
    OVERLAY_LINES=(
        "Today — $today"
