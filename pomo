# ================================ TIMER =====================================

run_timer() {
    # $1 durasi detik, $2 judul mode
    # $3 (opsional) sisa detik awal — dipakai "pomo resume" untuk mulai
    #     dari sisa waktu; progress bar tetap dihitung dari durasi penuh $1.
    # Return: 0 = selesai, 1 = user quit, 2 = user skip,
    #         3 = ganti ke short break (menu), 4 = ganti ke long break (menu),
    #         5 = ganti ke focus (menu)
    local total=$1 label=$2 start=${3:-$1}
    local end now remaining frozen paused=0 key rc
    local last_frame=''
    local menu_was_paused=0

    end=$(( $(now) + start ))
    frozen=$start
    write_state "$end" "$total" 0 "$start"

    # Animasi intro: digit besar menyala piksel demi piksel (~0.35s),
    # hanya di terminal interaktif yang cukup besar.
    if (( ANIM_ENABLED && INTERACTIVE )) \
        && (( TERM_COLS >= MIN_COLS && TERM_LINES >= MIN_ROWS )); then
        local fr
        for fr in 30 55 80 100; do
            draw_ui "$frozen" "$total" "$label" 0 "$fr"
            sleep 0.09
        done
        last_frame=''
    fi

    while :; do
        if (( paused )); then
            remaining=$frozen
        else
            now=$(now)
            remaining=$(( end - now ))
            if (( remaining <= 0 )); then
                draw_ui 0 "$total" "$label" 0
                return 0
            fi
            frozen=$remaining
            activity_sample_tick
        fi

        if (( RESIZED )); then
            update_term_size
        fi
        # Gambar ulang hanya saat ada perubahan (detik/pause/resize)
        local frame_key="$remaining-$paused-${TERM_COLS}x${TERM_LINES}"
        if [[ $frame_key != "$last_frame" || $RESIZED == 1 ]]; then
            draw_ui "$remaining" "$total" "$label" "$paused"
            # Status untuk "pomo status" ikut detik/pause yang tampil
            write_state "$end" "$total" "$paused" "$remaining"
            last_frame=$frame_key
            RESIZED=0
        fi

        # Baca input tanpa menghentikan loop utama
        key=''
        if (( INTERACTIVE )); then
            # rc: 0 = ada tombol, >128 = timeout read, 1 = EOF di stdin
            rc=0
            IFS= read -r -s -n 1 -t 0.1 key || rc=$?
            if (( rc > 0 && rc <= 128 )); then
                # stdin tertutup (EOF): jatuh ke mode non-interaktif
                INTERACTIVE=0
                sleep 1
                continue
            fi
        else
            sleep 1
        fi

        case $key in
            q|Q)
                # Konfirmasi quit: salah tekan tidak langsung keluar dari sesi
                OVERLAY_LINES=(
                    'Quit pomo?'
                    ''
                    'The current session ends — nothing is logged.'
                    ''
                    '[q] Quit    ·    any other key to go back'
                )
                draw_overlay 'QUIT' ''
                local qk=''
                if ! read_key qk; then
                    return 1   # EOF di stdin = quit
                fi
                if [[ $qk == q || $qk == Q ]]; then
                    return 1
                fi
                last_frame=''   # paksa redraw timer setelah overlay
                ;;
            p|P)
                if (( paused )); then
                    paused=0
                    end=$(( $(now) + frozen ))
                    ACT_LAST_SAMPLE_EPOCH=0
                    [[ -n $IDLE_STATE_FILE && -f $IDLE_STATE_FILE ]] && printf '0\n' > "$IDLE_STATE_FILE" 2>/dev/null || true
                else
                    paused=1
                fi
                ;;
            s|S)
                return 2
                ;;
            m|M)
                # Buka menu; bekukan timer selama menu terbuka
                menu_was_paused=$paused
                paused=1
                MENU_RESULT=''
                open_menu
                if (( THEME_CHANGED )); then
                    # Tema berganti dari menu: terapkan ulang warna mode
                    set_mode_colors "$CURRENT_MODE"
                    THEME_CHANGED=0
                fi
                case $MENU_RESULT in
                    focus)       return 5 ;;
                    short_break) return 3 ;;
                    long_break)  return 4 ;;
                    quit)        return 1 ;;
                    *)  # back (atau nilai tak terduga): jangan biarkan timer beku
                        # Lanjutkan sesi dengan sisa waktu yang sama
                        if (( menu_was_paused == 0 )); then
                            paused=0
                            end=$(( $(now) + frozen ))
                            ACT_LAST_SAMPLE_EPOCH=0
                            [[ -n $IDLE_STATE_FILE && -f $IDLE_STATE_FILE ]] && printf '0\n' > "$IDLE_STATE_FILE" 2>/dev/null || true
                        fi
                        # Paksa redraw timer karena layar berisi overlay menu
                        last_frame=''
                        ;;
                esac
                ;;
        esac
    done
}

# ============================ ALUR SESI / SIKLUS ============================

prompt_continue() {
    # $1 judul, $2 pesan, $3 label mode berikutnya
    # $4 opsional: 'focus_recap', $5 opsional: durasi sesi (detik)
    # Return: 0 = lanjut, 1 = berhenti.
    # Bila user memilih sesi lewat menu di layar ini, mode berikutnya
    # di-override lewat global PROMPT_NEXT_MODE.
    local title=$1 msg=$2 next_label=$3 style=${4:-} duration=${5:-0}
    if (( ! INTERACTIVE )); then
        # Mode non-interaktif (stdin bukan tty): sesi tunggal lalu selesai.
        printf '%s\n' "$title — $msg"
        return 1
    fi

    local ans=''
    while :; do
        if [[ $style == focus_recap ]]; then
            draw_focus_recap "$duration" "$next_label"
        else
            draw_message "$title" "$msg" \
                "Press [Enter] to start $next_label  ·  [m] menu  ·  [t] stats  ·  [d] durations  ·  [q] to quit"
        fi
        ans=''
        if ! read_key ans; then
            return 1   # EOF di stdin
        fi
        case $ans in
            '') return 0 ;;       # Enter ditekan
            q|Q) return 1 ;;
            m|M)
                MENU_RESULT=''
                open_menu
                case $MENU_RESULT in
                    focus|short_break|long_break)
                        PROMPT_NEXT_MODE=$MENU_RESULT
                        return 0
                        ;;
                    quit) return 1 ;;
                    back) : ;;    # tampilkan lagi layar konfirmasi
                esac
                ;;
            t|T) show_stats_overlay ;;
            d|D) show_duration_config_overlay ;;
        esac
    done
}

mode_label() {
    case $1 in
        focus)        echo 'FOCUS SESSION' ;;
        short_break)  echo 'SHORT BREAK' ;;
        long_break)   echo 'LONG BREAK' ;;
    esac
}

mode_duration() {
    case $1 in
        focus)        echo "$FOCUS_SECONDS" ;;
        short_break)  echo "$SHORT_BREAK_SECONDS" ;;
        long_break)   echo "$LONG_BREAK_SECONDS" ;;
    esac
}

run_cycle() {
    # $1 mode awal: focus|short_break|long_break
    # Jika RESUME_REMAINING > 0 (dari "pomo resume"), sesi pertama dimulai
    # dari sisa waktu itu; sesi-sesi berikutnya normal.
    local mode=$1
    local focus_done=0   # jumlah fokus selesai dalam siklus ini
    local resume_remaining=${RESUME_REMAINING:-0}
    RESUME_REMAINING=0
    local rc completed duration label next next_label msg

    while :; do
        duration=$(mode_duration "$mode")
        # Sisa resume tidak boleh melebihi durasi mode (state basi/rusak)
        (( resume_remaining > duration )) && resume_remaining=$duration
        label=$(mode_label "$mode")
        CURRENT_MODE=$mode
        set_mode_colors "$mode"
        if [[ $mode == focus ]]; then
            detect_tracker_backend
            activity_reset
            start_idle_watcher
        fi

        # Indikator progres siklus untuk layar timer (● = fokus selesai di
        # siklus berjalan; saat long break semua terisi).
        local fd dots='' di
        if [[ $mode == long_break ]]; then
            fd=$CYCLES_BEFORE_LONG
        else
            fd=$(( focus_done % CYCLES_BEFORE_LONG ))
        fi
        for (( di = 0; di < fd; di++ )); do dots+='●'; done
        for (( di = fd; di < CYCLES_BEFORE_LONG; di++ )); do dots+='○'; done
        CYCLE_DOTS=$dots

        rc=0
        if (( resume_remaining )); then
            run_timer "$duration" "$label" "$resume_remaining" || rc=$?
            resume_remaining=0
        else
            run_timer "$duration" "$label" || rc=$?
        fi
        stop_idle_watcher
        clear_state
        case $rc in
            1)
                return 0    # quit
                ;;
            3)
                mode=short_break   # ganti mode via menu: sesi ditinggalkan, tanpa log
                continue
                ;;
            4)
                mode=long_break
                continue
                ;;
            5)
                mode=focus
                continue
                ;;
        esac
        completed=$(( rc == 0 ? 1 : 0 ))

        if (( completed )); then
            case $mode in
                focus)
                    notify 'Focus session complete' \
                        "Nice work — $(( duration / 60 )) minutes of focus logged."
                    play_speaker "$FOCUS_SOUND"
                    log_session focus "$duration"
                    log_activity "$duration"
                    focus_done=$(( focus_done + 1 ))
                    ;;
                short_break)
                    notify 'Short break over' 'Ready for another focus session?'
                    play_speaker "$BREAK_SOUND"
                    log_session short_break "$duration"
                    ;;
                long_break)
                    notify 'Long break over' 'Refreshed — time to get back to work.'
                    play_speaker "$BREAK_SOUND"
                    log_session long_break "$duration"
                    ;;
            esac
            msg="$label finished — nothing skipped, all $(( duration / 60 )) min logged."
        else
            msg="$label skipped — nothing was logged."
        fi

        # Tentukan mode berikutnya: fokus -> break (panjang tiap ke-4 yang selesai), break -> fokus
        if [[ $mode == focus ]]; then
            if (( completed && focus_done > 0 && focus_done % CYCLES_BEFORE_LONG == 0 )); then
                next=long_break
            else
                next=short_break
            fi
        else
            next=focus
        fi
        next_label=$(mode_label "$next")

        if (( completed )); then
            if [[ $mode == focus ]]; then
                if ! prompt_continue 'SESSION COMPLETE' "$msg" "$next_label" focus_recap "$duration"; then
                    return 0
                fi
            elif ! prompt_continue 'SESSION COMPLETE' "$msg" "$next_label"; then
                return 0
            fi
        else
            if ! prompt_continue 'SESSION SKIPPED' "$msg" "$next_label"; then
                return 0
            fi
        fi
        # Mode berikutnya bisa di-override dari menu di layar antar-sesi
        if [[ -n ${PROMPT_NEXT_MODE:-} ]]; then
            next=$PROMPT_NEXT_MODE
            PROMPT_NEXT_MODE=''
        fi
        mode=$next
    done
}

start_session() {
    # $1 mode awal
    validate_durations
    init_terminal

    # Show confirmation in UI for focus mode
    if [[ $1 == "focus" && ${2:-} == "confirm" ]]; then
        local label duration mins confirm_msg
        label=$(mode_label "$1")
        duration=$(mode_duration "$1")
        mins=$(( duration / 60 ))
        set_mode_colors "$1"

        confirm_msg="Start $label ($mins min)?"
        if [[ -n $SESSION_TASK ]]; then
            confirm_msg="Start $label ($mins min) — $SESSION_TASK?"
        fi
        draw_message "START CONFIRMATION" "$confirm_msg" "Press [Enter] to start  ·  [q] to quit"

        local ans=''
        while :; do
            ans=''
            if ! read_key ans; then
                cleanup
                exit 0
            fi
            case $ans in
                '')
                    break  # Enter ditekan - lanjutkan
                    ;;
                q|Q|ESC)
                    cleanup
                    printf 'Focus session cancelled.\n'
                    exit 0
                    ;;
            esac
        done
    fi

    run_cycle "$1"
}

# ================================= STATS ====================================

# Riwayat sesi dibaca sekali ke array global per tanggal:
# FOCUS_COUNT (jumlah sesi), FOCUS_SECS (total detik), BREAK_COUNT (jumlah break)
declare -gA FOCUS_COUNT=() FOCUS_SECS=() BREAK_COUNT=()

read_history() {
    # Return: 0 = file riwayat ada dan terbaca, 1 = belum ada
    FOCUS_COUNT=()
    FOCUS_SECS=()
    BREAK_COUNT=()
    if [[ ! -f $HISTORY_FILE ]]; then
        return 1
    fi
    local d t s
    while IFS='|' read -r d t s || [[ -n ${d:-} ]]; do
        if [[ -z ${d:-} ]]; then continue; fi
        if [[ ! $d =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then continue; fi
        if [[ ! $s =~ ^[0-9]+$ ]]; then continue; fi
        case $t in
            focus)
                FOCUS_COUNT[$d]=$(( ${FOCUS_COUNT[$d]:-0} + 1 ))
                FOCUS_SECS[$d]=$(( ${FOCUS_SECS[$d]:-0} + s ))
                ;;
            short_break|long_break)
                BREAK_COUNT[$d]=$(( ${BREAK_COUNT[$d]:-0} + 1 ))
                ;;
        esac
    done < "$HISTORY_FILE"
    return 0
}

show_stats() {
    if ! read_history; then
        printf 'No sessions recorded yet.\n'
        printf 'Run "pomo" to start your first focus session.\n'
        printf 'History will be saved in %s\n' "$HISTORY_FILE"
        return 0
    fi

    local today
    today=$(date +%F)

    printf '%sPomodoro Statistics%s\n' "$C_BOLD" "$C_RESET"
    printf '\n'
    printf '%sToday — %s%s\n' "$C_DIM" "$today" "$C_RESET"
    printf '  Focus sessions : %s%s%s\n' "$C_GREEN" "${FOCUS_COUNT[$today]:-0}" "$C_RESET"
    printf '  Focus minutes  : %s%s%s\n' "$C_GREEN" "$(( ${FOCUS_SECS[$today]:-0} / 60 ))" "$C_RESET"
    printf '  Breaks taken   : %s%s%s\n' "$C_CYAN" "${BREAK_COUNT[$today]:-0}" "$C_RESET"

    printf '\n'
    printf '%sLast 7 days%s\n' "$C_BOLD" "$C_RESET"
    printf '  %-12s %8s %8s\n' 'Date' 'Sessions' 'Minutes'

    # Skala bar: berdasarkan hari terproduktif dalam 7 hari terakhir
    local max_minutes=0 day mins i
    for (( i = 6; i >= 0; i-- )); do
        day=$(date -d "-$i day" +%F)
        mins=$(( ${FOCUS_SECS[$day]:-0} / 60 ))
        if (( mins > max_minutes )); then max_minutes=$mins; fi
    done

    local total_sessions=0 total_minutes=0 bar='' j filled
    for (( i = 6; i >= 0; i-- )); do
        day=$(date -d "-$i day" +%F)
        mins=$(( ${FOCUS_SECS[$day]:-0} / 60 ))
        total_sessions=$(( total_sessions + ${FOCUS_COUNT[$day]:-0} ))
        total_minutes=$(( total_minutes + mins ))

        bar=''
        if (( max_minutes > 0 )); then
            filled=$(( mins * 20 / max_minutes ))
            for (( j = 0; j < filled; j++ )); do bar+='▓'; done
        fi
        printf '  %s%-12s%s %s%8s%s %s%8s%s  %s%s%s\n' \
            "$C_CYAN" "$day" "$C_RESET" \
            "$C_GREEN" "${FOCUS_COUNT[$day]:-0}" "$C_RESET" \
            "$C_GREEN" "$mins" "$C_RESET" \
            "${C_BAR:-$C_GREEN}" "$bar" "$C_RESET"
    done

    printf '\n'
    printf '%s7-day total:%s %d sessions · %d minutes focused\n' \
        "$C_DIM" "$C_RESET" "$total_sessions" "$total_minutes"

    # Ringkasan singkat Top Apps Today bila ada data aktivitas hari ini
    if [[ -f $ACTIVITY_FILE ]]; then
        local -A today_apps=()
        local -a pairs=()
        local a_date a_csv pair app_k app_v total_app_secs=0
        while IFS='|' read -r a_date _ _ _ _ _ _ a_csv || [[ -n ${a_date:-} ]]; do
            [[ $a_date == "$today" && -n ${a_csv:-} ]] || continue
            IFS=',' read -ra pairs <<< "$a_csv"
            for pair in "${pairs[@]}"; do
                [[ $pair == *=* ]] || continue
                app_k=${pair%%=*}
                app_v=${pair#*=}
                [[ -n $app_k && $app_v =~ ^[0-9]+$ ]] || continue
                today_apps[$app_k]=$(( ${today_apps[$app_k]:-0} + app_v ))
                total_app_secs=$(( total_app_secs + app_v ))
            done
        done < "$ACTIVITY_FILE"

        if (( total_app_secs > 0 )); then
            printf '\n'
            printf '%sTop Apps Today%s\n' "$C_BOLD" "$C_RESET"
            local shown=0 app_s app_n pct bar_s f_len k_i d_fmt
            while IFS='|' read -r app_s app_n; do
                [[ -n $app_n ]] || continue
                (( shown >= 5 )) && break
                shown=$(( shown + 1 ))
                pct=$(( app_s * 100 / total_app_secs ))
                f_len=$(( pct * 20 / 100 ))
                (( f_len == 0 && app_s > 0 )) && f_len=1
                bar_s=''
                for (( k_i = 0; k_i < f_len; k_i++ )); do bar_s+='━'; done
                d_fmt=$(format_duration_short "$app_s")
                printf '  %s%-14s%s %s%4s%s %s(%3d%%)%s  %s%s%s\n' \
                    "$C_CYAN" "$app_n" "$C_RESET" \
                    "$C_GREEN" "$d_fmt" "$C_RESET" \
                    "$C_DIM" "$pct" "$C_RESET" \
                    "${C_BAR:-$C_GREEN}" "$bar_s" "$C_RESET"
            done < <(
                for app_k in "${!today_apps[@]}"; do
                    printf '%d|%s\n' "${today_apps[$app_k]}" "$app_k"
                done | sort -t'|' -k1,1nr -k2,2
            )
        fi
    fi
}

show_recap() {
    # $1 opsional: 'last' | 'today' (default: today)
    local scope=${1:-today}
    if [[ $scope != today && $scope != last ]]; then
        die "unknown recap option: '$scope'" "Usage: pomo recap [today|last]"
    fi
    if [[ ! -f $ACTIVITY_FILE ]]; then
        printf 'No focus activity recaps recorded yet.\n'
        printf 'Run "pomo" and complete a focus session to record activity.\n'
        printf 'Activity recaps will be saved in %s\n' "$ACTIVITY_FILE"
        return 0
    fi

    local today
    today=$(date +%F)

    if [[ $scope == last ]]; then
        local last_line='' line
        while IFS= read -r line || [[ -n $line ]]; do
            [[ -n $line ]] && last_line=$line
        done < "$ACTIVITY_FILE"
        if [[ -z $last_line ]]; then
            printf 'No focus activity recaps recorded yet.\n'
            return 0
        fi
        local d tm dur task sw act idle csv
        IFS='|' read -r d tm dur task sw act idle csv <<< "$last_line"
        local dur_fmt tot_t act_pct=100
        dur_fmt=$(format_duration_short "${dur:-0}")
        tot_t=$(( ${act:-0} + ${idle:-0} ))
        (( tot_t > 0 )) && act_pct=$(( act * 100 / tot_t ))
        printf '%sLast Focus Recap%s — %s %s (%s)\n' "$C_BOLD" "$C_RESET" "$d" "$tm" "$dur_fmt"
        if [[ -n ${task:-} ]]; then
            printf '  Task     : %s%s%s\n' "$C_WHITE" "$task" "$C_RESET"
        fi
        if (( tot_t > 0 )); then
            local idle_pct=$(( 100 - act_pct )) idle_fmt
            idle_fmt=$(format_duration_short "${idle:-0}")
            printf '  Activity : %s%d%% active%s · %d app switches\n' "$C_GREEN" "$act_pct" "$C_RESET" "${sw:-0}"
            printf '  Idle     : %s%d%% idle%s (%s)\n' "$C_YELLOW" "$idle_pct" "$C_RESET" "$idle_fmt"
        fi
        if [[ -n ${csv:-} ]]; then
            printf '  Apps used:\n'
            local -a pairs=()
            local pair app_k app_v pct f_len bar_s k_i d_fmt
            IFS=',' read -ra pairs <<< "$csv"
            for pair in "${pairs[@]}"; do
                [[ $pair == *=* ]] || continue
                app_k=${pair%%=*}
                app_v=${pair#*=}
                [[ -n $app_k && $app_v =~ ^[0-9]+$ ]] || continue
                pct=0
                (( tot_t > 0 )) && pct=$(( app_v * 100 / tot_t ))
                f_len=$(( pct * 20 / 100 ))
                (( f_len == 0 && app_v > 0 )) && f_len=1
                bar_s=''
                for (( k_i = 0; k_i < f_len; k_i++ )); do bar_s+='━'; done
                d_fmt=$(format_duration_short "$app_v")
                printf '    %s%-14s%s %s%4s%s %s(%3d%%)%s  %s%s%s\n' \
                    "$C_CYAN" "$app_k" "$C_RESET" \
                    "$C_GREEN" "$d_fmt" "$C_RESET" \
                    "$C_DIM" "$pct" "$C_RESET" \
                    "$C_GREEN" "$bar_s" "$C_RESET"
            done
        fi
        return 0
    fi

    local -A agg_apps=()
    local count=0 total_sw=0 total_act=0 total_idle=0 total_app_secs=0
    local d tm dur task sw act idle csv
    local -a session_lines=()
    while IFS='|' read -r d tm dur task sw act idle csv || [[ -n ${d:-} ]]; do
        [[ $d == "$today" ]] || continue
        count=$(( count + 1 ))
        total_sw=$(( total_sw + ${sw:-0} ))
        total_act=$(( total_act + ${act:-0} ))
        total_idle=$(( total_idle + ${idle:-0} ))
        local dur_fmt top_app='-' s_line
        dur_fmt=$(format_duration_short "${dur:-0}")
        if [[ -n ${csv:-} ]]; then
            local -a pairs=()
            local pair app_k app_v first=1
            IFS=',' read -ra pairs <<< "$csv"
            for pair in "${pairs[@]}"; do
                [[ $pair == *=* ]] || continue
                app_k=${pair%%=*}
                app_v=${pair#*=}
                [[ -n $app_k && $app_v =~ ^[0-9]+$ ]] || continue
                if (( first )); then
                    top_app="$app_k ($(format_duration_short "$app_v"))"
                    first=0
                fi
                agg_apps[$app_k]=$(( ${agg_apps[$app_k]:-0} + app_v ))
                total_app_secs=$(( total_app_secs + app_v ))
            done
        fi
        s_line="  $tm  $dur_fmt"
        [[ -n ${task:-} ]] && s_line+="  [$task]"
        s_line+="  · top: $top_app  · ${sw:-0} switches"
        session_lines+=("$s_line")
    done < "$ACTIVITY_FILE"

    if (( count == 0 )); then
        printf 'No focus activity recorded today (%s).\n' "$today"
        printf 'Run "pomo recap last" to view your most recent recorded session.\n'
        return 0
    fi

    printf '%sFocus Activity Recap%s — %s\n\n' "$C_BOLD" "$C_RESET" "$today"
    local tot_t=$(( total_act + total_idle )) act_pct=100
    (( tot_t > 0 )) && act_pct=$(( total_act * 100 / tot_t ))
    printf '  Sessions : %s%d%s\n' "$C_GREEN" "$count" "$C_RESET"
    if (( tot_t > 0 )); then
        local idle_pct=$(( 100 - act_pct )) idle_fmt
        idle_fmt=$(format_duration_short "$total_idle")
        printf '  Activity : %s%d%% active%s · %d total app switches\n' "$C_GREEN" "$act_pct" "$C_RESET" "$total_sw"
        printf '  Idle     : %s%d%% idle%s (%s)\n' "$C_YELLOW" "$idle_pct" "$C_RESET" "$idle_fmt"
    fi

    printf '\n%sSessions today%s\n' "$C_BOLD" "$C_RESET"
    local sl
    for sl in "${session_lines[@]}"; do
        printf '%s\n' "$sl"
    done

    if (( total_app_secs > 0 )); then
        printf '\n%sTop Apps Today%s\n' "$C_BOLD" "$C_RESET"
        local app_s app_n pct f_len bar_s k_i d_fmt ak
        while IFS='|' read -r app_s app_n; do
            [[ -n $app_n ]] || continue
            pct=$(( app_s * 100 / total_app_secs ))
            f_len=$(( pct * 20 / 100 ))
            (( f_len == 0 && app_s > 0 )) && f_len=1
            bar_s=''
            for (( k_i = 0; k_i < f_len; k_i++ )); do bar_s+='━'; done
            d_fmt=$(format_duration_short "$app_s")
            printf '  %s%-14s%s %s%4s%s %s(%3d%%)%s  %s%s%s\n' \
                "$C_CYAN" "$app_n" "$C_RESET" \
                "$C_GREEN" "$d_fmt" "$C_RESET" \
                "$C_DIM" "$pct" "$C_RESET" \
                "$C_GREEN" "$bar_s" "$C_RESET"
        done < <(
            for ak in "${!agg_apps[@]}"; do
                printf '%d|%s\n' "${agg_apps[$ak]}" "$ak"
            done | sort -t'|' -k1,1nr -k2,2
        )
    fi
}

